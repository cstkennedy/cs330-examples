from _typeshed import Incomplete
from collections.abc import Sequence
from typing import Any, final

@final
class CompletedGame:
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...

@final
class Game:
    def __new__(cls, /, player1: Player, player2: Player) -> Game: ...
    @staticmethod
    def new_with_hardcoded_players() -> Game: ...
    def play_match(self, /) -> CompletedGame: ...

@final
class Player:
    @staticmethod
    def create_computer(name: str, moves: Sequence[int]) -> Player: ...
    @staticmethod
    def create_custom_computer(name: str, strategy: Any) -> Player: ...
    @staticmethod
    def create_human(name: str) -> Player: ...

def __getattr__(name: str) -> Incomplete: ...
